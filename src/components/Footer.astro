<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <img src="/logo.jpg" alt="Think Savvy — Smart Solutions" />
      <p>Fleet data, sorted.</p>
    </div>
    <div class="footer-links">
      <a href="https://www.linkedin.com/company/thinksavvy" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href="#contact">Get in touch</a>
    </div>
  </div>
  <div class="wrap footer-legal">
    <p>Think Savvy Ltd &middot; Company No. 17380071</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--green-deep);
    color: var(--cream-soft);
    padding: 48px 0 24px;
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    padding-bottom: 24px;
    border-bottom: 1px solid rgba(246, 241, 232, 0.18);
  }
  .footer-brand {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .footer-brand img {
    height: 34px;
    border-radius: 6px;
  }
  .footer-brand p {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--cream-soft);
  }
  .footer-links {
    display: flex;
    gap: 24px;
  }
  .footer-links a {
    color: var(--cream-soft);
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
  }
  .footer-links a:hover { color: var(--terracotta); }

  .footer-legal {
    padding-top: 20px;
    font-size: 13px;
    color: rgba(246, 241, 232, 0.6);
  }
</style>
