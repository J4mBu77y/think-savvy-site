---
---
<header class="site-header">
  <div class="wrap header-inner">
    <a href="#top" class="brand">
      <img src="/logo.jpg" alt="Think Savvy — Smart Solutions" />
      <span class="brand-tagline">Fleet data, sorted.</span>
    </a>
    <nav class="nav">
      <a href="#story">Read Our Story</a>
      <a href="#services">Services</a>
      <a href="#how-it-works">How it works</a>
      <a href="#contact" class="btn btn-primary btn-sm">Get in touch</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(246, 241, 232, 0.9);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 2px;
    padding-bottom: 2px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 16px;
    text-decoration: none;
  }
  .brand img {
    height: 172px;
    width: auto;
    display: block;
    border-radius: 10px;
  }
  .brand-tagline {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 17px;
    color: var(--green-deep);
    white-space: nowrap;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 26px;
  }
  .nav a:not(.btn) {
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    color: var(--green-deep);
  }
  .nav a:not(.btn):hover { color: var(--terracotta); }

  @media (max-width: 900px) {
    .nav a:not(.btn):not(:last-child) { display: none; }
  }
  @media (max-width: 640px) {
    .brand img { height: 112px; }
    .brand-tagline { display: none; }
  }
</style>
